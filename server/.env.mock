# ──────────────────────────────────────────────────────────────────────────
#  Локальная разработка без банка: API + заглушка KICB.
#  Секретов здесь нет, файл лежит в git.
#    npm run mock       — заглушка банка на :8788
#    npm run dev:mock   — API на :8787 поверх заглушки
# ──────────────────────────────────────────────────────────────────────────

PORT=8787
HOST=127.0.0.1
PUBLIC_URL=http://localhost:5173

KICB_MODE=mock
KICB_BASE_URL=http://127.0.0.1:8788
KICB_LOGIN=test
KICB_PASSWORD=testpassword
KICB_TERMINAL_ID=1Test1Test
KICB_TERMINAL_PUBLIC_KEY_FILE=
KICB_TERMINAL_PUBLIC_KEY=

ORDER_TTL_SECONDS=600

# Тот же прайс, что и на боевом — иначе локальные проверки ничего не значат.
PRICE_ADULT=3
PRICE_REDUCED=1
PRICE_FAMILY=5

# SMTP не настроен — билеты печатаются в консоль.
SMTP_HOST=
MAIL_FROM="AI Museum <tickets@example.kg>"

# Пароль к админке (/admin). На боевом — длинная случайная строка.
ADMIN_TOKEN=dev-admin

