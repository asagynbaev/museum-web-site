# ──────────────────────────────────────────────────────────────────────────
#  AI Museum · билетный сервер
#  Скопируйте в .env и заполните. .env в git не коммитится.
# ──────────────────────────────────────────────────────────────────────────

PORT=8787
HOST=127.0.0.1

# Публичный адрес сайта. Уходит в письма (ссылка проверки билета)
# и в список разрешённых Origin для CORS.
PUBLIC_URL=http://localhost:5173

# ── KICB Terminal API ─────────────────────────────────────────────────────
# mock — локальная заглушка (npm run mock), live — настоящий банк.
# Боевой контур:   KICB_MODE=live + KICB_BASE_URL=https://api.kicb.net
# Тестовый контур: KICB_MODE=live + KICB_BASE_URL=https://api-dev.kicb.net
KICB_MODE=mock

# baseURL выдаёт банк. Для мока — http://127.0.0.1:8788
KICB_BASE_URL=http://127.0.0.1:8788
KICB_LOGIN=test
KICB_PASSWORD=testpassword
# terminalId выдаёт банк вместе с доступами (свой для каждого контура).
# 1Test1Test — тестовый из доки.
KICB_TERMINAL_ID=1Test1Test

# Публичный RSA-ключ терминала. Нужен ТОЛЬКО при работе без IPSec VPN:
# тогда terminalId уходит зашифрованным (RSA/OAEP-SHA256 → base64), раздел 4.2 доки.
# Если сидите в VPN-туннеле — оставьте обе переменные пустыми, terminalId уйдёт как есть.
# Путь считается от корня server/:
KICB_TERMINAL_PUBLIC_KEY_FILE=
# Либо тот же PEM одной строкой, с \n вместо переносов:
# KICB_TERMINAL_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
KICB_TERMINAL_PUBLIC_KEY=

# Сколько ждём ответ банка, мс.
KICB_TIMEOUT_MS=15000

# Сколько живёт QR до автоотмены, секунд.
ORDER_TTL_SECONDS=600

# ── Цены (в сомах, за одну единицу) ───────────────────────────────────────
# ВНИМАНИЕ: это единственный источник правды по ценам. Клиент присылает только
# id тарифа и количество — сумму считает сервер.
# Для пробных платежей на живых деньгах можно временно поставить 3/1/5.
PRICE_ADULT=1600
PRICE_REDUCED=1200
PRICE_FAMILY=4800

# ── Админка (/admin) ──────────────────────────────────────────────────────
# Пароль к служебной странице со статусами оплат. Пусто — раздел выключен.
# Сгенерировать: openssl rand -base64 24
ADMIN_TOKEN=

# ── Турникет (/api/gate/*) ─────────────────────────────────────────────────
# Отдельный токен для сканера на входе — НЕ тот же, что ADMIN_TOKEN: если
# устройство на турникете скомпрометируют, с этим токеном нельзя ничего,
# кроме как проверить/погасить один билет. Пусто — раздел выключен.
# Сгенерировать: openssl rand -base64 24
GATE_TOKEN=

# ── SMTP для отправки билетов ─────────────────────────────────────────────
# Если не заполнено — письма не уходят, а печатаются в консоль (dev-режим).
# Google Workspace (ящик events@htp.kg): host smtp.gmail.com, порт 465, secure.
# ⚠️ В SMTP_PASSWORD идёт НЕ пароль от аккаунта, а «пароль приложения» на 16
# символов из myaccount.google.com/apppasswords (пробелы убрать). С обычным
# паролем Google отвечает «534-5.7.9 Application-specific password required».
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="AI Museum <tickets@example.kg>"

# ── Сеансы (продажа по часам) ─────────────────────────────────────────────
# Время — по Бишкеку. Сеансы каждый час с первого по последний включительно.
SLOT_CAPACITY=20
SLOT_FIRST_HOUR=10
SLOT_LAST_HOUR=19
# На сколько месяцев вперёд продаём.
BOOKING_HORIZON_MONTHS=3
# Выходные дни недели: 0 — вс, 1 — пн … 6 — сб, через запятую.
CLOSED_WEEKDAYS=1
# Праздники и санитарные дни: YYYY-MM-DD через запятую.
CLOSED_DATES=
# Сеанс продаётся, пока с его начала прошло меньше N минут.
SLOT_SALES_CLOSE_MIN=45
# Турникет пускает за N минут до начала сеанса и до M минут после.
GATE_EARLY_MIN=15
GATE_LATE_MIN=60
