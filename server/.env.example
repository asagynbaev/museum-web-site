# ──────────────────────────────────────────────────────────────────────────
#  AI Museum · билетный сервер
#  Скопируйте в .env и заполните. .env в git не коммитится.
# ──────────────────────────────────────────────────────────────────────────

PORT=8787
HOST=127.0.0.1

# Публичный адрес сайта. Уходит в письма (ссылка проверки билета)
# и в список разрешённых Origin для CORS.
PUBLIC_URL=http://localhost:5173

# ── KICB Terminal API ─────────────────────────────────────────────────────
# mock — локальная заглушка (npm run mock), live — настоящий банк.
# Тестовый контур банка: KICB_MODE=live + KICB_BASE_URL=https://api-dev.kicb.net
KICB_MODE=mock

# baseURL выдаёт банк. Для мока — http://127.0.0.1:8788
KICB_BASE_URL=http://127.0.0.1:8788
KICB_LOGIN=test
KICB_PASSWORD=testpassword
# terminalId выдаёт банк вместе с доступами. 1Test1Test — тестовый из доки.
KICB_TERMINAL_ID=1Test1Test

# Публичный RSA-ключ терминала. Нужен ТОЛЬКО при работе без IPSec VPN:
# тогда terminalId уходит зашифрованным (RSA/OAEP-SHA256 → base64), раздел 4.2 доки.
# Если сидите в VPN-туннеле — оставьте обе переменные пустыми, terminalId уйдёт как есть.
# Путь считается от корня server/:
KICB_TERMINAL_PUBLIC_KEY_FILE=
# Либо тот же PEM одной строкой, с \n вместо переносов:
# KICB_TERMINAL_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
KICB_TERMINAL_PUBLIC_KEY=

# Сколько ждём ответ банка, мс.
KICB_TIMEOUT_MS=15000

# Сколько живёт QR до автоотмены, секунд.
ORDER_TTL_SECONDS=600

# ── Цены (в сомах, за одну единицу) ───────────────────────────────────────
# ВНИМАНИЕ: это единственный источник правды по ценам. Клиент присылает только
# id тарифа и количество — сумму считает сервер.
# Сейчас стоят тестовые 1/3/5 сом — заменить на настоящие до запуска продаж.
PRICE_ADULT=3
PRICE_REDUCED=1
PRICE_FAMILY=5

# ── SMTP для отправки билетов ─────────────────────────────────────────────
# Если не заполнено — письма не уходят, а печатаются в консоль (dev-режим).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="AI Museum <tickets@example.kg>"
