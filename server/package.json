{
  "name": "ai-museum-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Билетный бэкенд AI Museum: оплата через KICB Terminal QR + выдача билетов",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "dev:mock": "node --env-file=.env.mock --watch src/index.js",
    "mock": "node --env-file=.env.mock src/mock/kicb-mock.js",
    "mail:test": "node --env-file=.env src/tools/send-test-mail.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/formbody": "^8.0.1",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.12.1",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4"
  }
}
